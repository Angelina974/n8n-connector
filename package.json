{
	"name": "n8n-nodes-airprocess",
	"version": "0.1.25",
	"description": "Community n8n node for AirProcess API integrations.",
	"license": "MIT",
	"homepage": "https://github.com/Angelina974/n8n-connector#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Angelina",
		"email": "julia.angelina.grossi@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Angelina974/n8n-connector.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"version:minor": "npm version patch --no-git-tag-version",
		"version:feature": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AirProcessApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AirProcess/AirProcess.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
